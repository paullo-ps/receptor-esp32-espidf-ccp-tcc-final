# IDES E FERRAMENTAS
# ==============================================================================
# VS Code (preferências locais: caminhos absolutos, porta serial, depuração)
.vscode/
*.code-workspace

# Dev Container (não utilizado no projeto)
.devcontainer/
.history/

# clangd: ignora apenas o cache (o arquivo .clangd é configuração e deve ser versionado)
.cache/

# JetBrains / Eclipse
.idea/
cmake-build-*/
.project
.cproject
.settings/

