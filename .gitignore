# ESP-IDF / BUILD
# ==============================================================================
build/
managed_components/
sdkconfig.old
flasher_args.json
compile_commands.json
*.o
*.a
*.elf
*.bin
*.map

# Observação: 'sdkconfig' É versionado de propósito (não há sdkconfig.defaults).
# Observação: 'dependencies.lock' deve ser versionado (builds reproduzíveis).

